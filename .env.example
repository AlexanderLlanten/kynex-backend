# Copiar como .env. No publicar el archivo con valores reales.
DB_NAME=kynex
DB_USERNAME=kynex
DB_PASSWORD=reemplazar-por-una-clave-local
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/kynex
# Al menos 32 bytes aleatorios. Se puede generar con el comando del README.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173
# false solamente para desarrollo local HTTP; true con HTTPS.
COOKIE_SECURE=false
# Opcional: crea una cuenta Administrador únicamente si no existe.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Entorno académico: habilita escenarios internos de pago sin cobros reales.
PAYMENT_EMULATOR_ENABLED=true
# Docker: los dos repositorios deben estar en carpetas hermanas.
FRONTEND_CONTEXT=../Fs2_pROYECTO
FRONTEND_PORT=8081
BACKEND_PORT=8082
